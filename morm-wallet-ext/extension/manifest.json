{
  "manifest_version": 3,
  "name": "MORM Wallet",
  "version": "0.0.1",
  "description": "MORM 純正ウォレット — m0r アカウントの保管・送受金。morm.one と同一 passkey で解錠。",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MORM Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.morm.one/*",
    "https://l1.morm.one/*",
    "https://node.morm.one/*",
    "https://morm.one/*",
    "https://www.morm.one/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://morm.one/*",
      "https://www.morm.one/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.morm.one https://l1.morm.one https://node.morm.one"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
