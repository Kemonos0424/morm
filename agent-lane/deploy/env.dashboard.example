# morm-dashboard (Vercel / api.morm.one) — 推奨初期値（base=1 初回ローンチ）
# すべて非破壊フラグ。Phase 表記の段でだけ有効化する（DEPLOY.md 参照）。

# --- L1 / 支払い口座（★DASH_PAYOUT に分離：クロスプロセス nonce 競合回避）---
MORM_L1_RPC_URL=<本番 L1 RPC URL（既存）>
# 「TREASURY」という名だが実体は DASH_PAYOUT 口座（faucet/lane earn/node emission/ad payout の署名者）
MORM_TREASURY_ADDRESS=m0roshqbpskljwuj3drophhb7tth33qprzn   # DASH_PAYOUT address
MORM_TREASURY_SEED=<~/.morm-agentlane/dash_payout.seed の中身(64hex)>  # ★Vercel暗号化envに。commit禁止

# --- 経済パラメータ（Play と一致させる）---
MORM_BASE_UNITS_PER_MORM=1        # 初回は 1（sub-MORM 移行=§G は後日）
B_EPOCH_MORM=1000                 # 1エポックの発行予算（小さく開始）
# ★口座上限=予算の何割か。少人数(数〜十数ノード)では自然に集中するので初回は 1.0(=実質off)。
#   参加者が増え untrusted が入ってきたら 0.05→0.005 と絞る（anti-whale）。
EPOCH_ACCT_CAP_FRAC=1.0
SPLIT_NODE=0.30                   # ノード・トラックの取り分（Play SPLIT_ENGAGE=0.60 と合わせて<=1）

# --- Agent Lane earn（Phase B）★ref実在検証が無く farmable → 小さく＋日次上限で絞る ---
MORM_LANE_EARN=1                  # 署名クレーム1回=1 MORM
MORM_LANE_EARN_DAILY_CAP=10       # 1口座/日 のクレーム上限（0 で lane earn 無効）。実 earning は budget上限トラックが担う

# --- 換金バルブ（Phase C：価格保護を先に）---
BRIDGE_VALVE=on
BRIDGE_SYSTEM_DAILY_FRAC=0.005    # システム日次=USDC準備金の0.5%（確定値）
BRIDGE_ACCT_DAILY_USD=2           # 1口座 日次上限（保守値）
BRIDGE_COOLDOWN_SEC=86400         # 24h クールダウン
BRIDGE_FALLBACK_DAILY_USD=3       # price/準備金不明時の保守cap（fail-safe）

# --- AD エスクロー（Phase F）---
AD_UNIT_PER_WEIGHT=1              # base=1 では 1 impression=1 MORM が下限（粗い。§G後に細粒度化）
AD_CLICK_WEIGHT=20               # 1 click = 20 impression-weight

# --- admin（★必須：強力な値に。既定1234で admin 経路を有効化しない）---
ADMIN_PASSWORD=<強力なパスワード>

# 既存 Turso 等はそのまま（LOCAL_SQLITE_URL は本番で未設定＝Turso）
