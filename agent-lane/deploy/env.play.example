# morm-play (Mac Mini launchd com.morm.play) — 推奨初期値（base=1 初回ローンチ）
# com.morm.play.plist の EnvironmentVariables に設定。非破壊フラグ。

# --- 支払い口座（★PLAY_PAYOUT に分離：ブロック producer とは別鍵）---
MORM_L1_RPC=http://127.0.0.1:8900                      # 既存
TREASURY_SEED_FILE=/Users/<user>/.morm-agentlane/play_payout.seed   # ★PLAY_PAYOUT（producer.seed とは別）

# --- 比例配分（Phase D）---
EMISSION_MODE=proportional        # 既定 fixed → proportional に切替
SPLIT_ENGAGE=0.60                 # engagement トラックの取り分（dashboard SPLIT_NODE=0.30 と合わせて<=1）
B_EPOCH_MORM=1000                 # dashboard と同値
EPOCH_ACCT_CAP_FRAC=1.0           # 初回は 1.0(実質off・少人数)。網が広がったら 0.05→0.005 に絞る（dashboard と一致）
MORM_BASE_UNITS_PER_MORM=1        # dashboard と一致（初回 1）
POINT_SETTLE_INTERVAL=86400       # 任意：72h→日次に（B_EPOCH を日次予算として扱うなら）

# --- view_by_other（Phase D：★フロントの署名 watch 出荷後に on）---
VIEW_EARN=on
PT_VIEW=1                          # 他者の有効再生1回=1 point（既存 PT_LIKE=1/PT_COMMENT=2/PT_SHARE=1）

# ADMIN_TOKEN は plist の平文コミットをローテすること（既知の課題）
