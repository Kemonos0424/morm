# MORM Node Dashboard - environment
# Copy to .env.local and fill in. Without these, the app falls back to a local
# file-based SQLite at db/dashboard.sqlite (see app/lib/db.js).

TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=<token>

# --- MORM L1 (admin/send real m0r transfers) ---------------------------------
# When BOTH MORM_L1_RPC_URL and MORM_TREASURY_SEED are set, /api/admin/send
# signs and submits a real TRANSFER tx to the MORM L1 node (app/lib/morm-l1.js).
# Leave unset to keep simulated txHashes (dashboard still works without a chain).
#
# SECURITY: MORM_TREASURY_SEED is a signing key. Server-side only — never commit
# it and never expose it to the client. (MORM is a PUBLIC repo: keep .env.local
# out of git.)
MORM_L1_RPC_URL=http://<node-host>:8900
MORM_TREASURY_SEED=<64-hex-char ed25519 seed>
MORM_TREASURY_ADDRESS=m0r<treasury address, for nonce lookup>
# Optional integer multiplier from display-MORM to L1 base units (default 1).
MORM_BASE_UNITS_PER_MORM=1
