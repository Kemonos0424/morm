# ============================================================================
# MORM mainnet (Base mainnet, chainId 8453) deploy env — TEMPLATE / .example
# ----------------------------------------------------------------------------
# ★このファイルは公開テンプレ。実鍵は絶対に書かない。コピーして
#     cp mainnet-deploy.env.example ../.mainnet-deploy.env   (.gitignore 済の場所)
#   としてから <FILL_...> を実値で埋め、`set -a; source ../.mainnet-deploy.env; set +a`。
# ★このリポは PUBLIC。秘密鍵/seed は .mainnet-deploy.env にのみ置き、コミットしない。
# ============================================================================

# --- chain / RPC ---
CHAIN_ID=8453
RPC_URL=<FILL_YOUR_BASE_MAINNET_RPC>          # あなた名義の有料RPC(Alchemy/Infura等)。public RPC 不可

# --- public addresses (Base mainnet・オンチェーン検証済 2026-08-29) ---
USDC_ADDR=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # 本物 Circle USDC (6 decimals)
NPM_ADDR=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1     # Uniswap v3 NonfungiblePositionManager
# 参考(UI/relayer 用): SwapRouter02=0x2626664c2603336E57B271c5C0b26F421741e481
#                       UniswapV3Factory=0x33128a8fC17869897dcE68Ed026d694621f6FDfD

# --- bridge immutable params (★一度きり・確定値: 3-of-5 / 終端規模) ---
THRESHOLD=3
SIGNERS=<FILL_0xA>,<FILL_0xB>,<FILL_0xC>,<FILL_0xD>,<FILL_0xE>   # 5署名アドレス(カンマ区切り)
WINDOW_LEN=3600                                          # 1h velocity 窓
MAX_MINT_PER_WINDOW=1000000000000000000000000            # 1e24 = 1,000,000 wMORM/時
MAX_SUPPLY=1000000000000000000000000000                  # 1e27 = 1,000,000,000 wMORM
MIN_EXIT=1000000000000000000                             # 1e18 = 1 wMORM (dust floor)
DEPLOY_MOCK_USDC=false                                   # ★本番は必ず false(実USDCを使う)

# --- guardian (可変・setGuardian で差替可。本番は実在の Gnosis Safe) ---
GUARDIAN=<FILL_GNOSIS_SAFE_ADDR>                         # 単一鍵にしない(緊急停止の単一障害点回避)

# --- deployer (broadcast する鍵。ハードウェア/新規・testnet鍵の再利用禁止) ---
DEPLOYER_PK=<FILL_MAINNET_DEPLOYER_PK>                   # ★.mainnet-deploy.env にのみ。コミット禁止

# --- pool seed 初動 (100 USDC + 10,000 wMORM @ $0.01。SeedPool.s.sol が balanced 検算) ---
SEED_USDC=100
SEED_WMORM=10000

# --- 以下はデプロイ後に確定して追記(移行に使用) ---
# WMORM_ADDR=0x...        # deploy ログの WMORM
# BRIDGE_ADDR=0x...       # deploy ログの MORMExportBridge
# POOL_ADDR=0x...         # SeedPool 後の pool
